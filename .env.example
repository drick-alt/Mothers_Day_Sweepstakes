# Mother's Day Sweepstakes Drawing - production environment example
# Copy to your host's Environment Variables panel. Do NOT commit real secrets.

# Required for admin console. If either is missing, /admin is closed with 503.
ADMIN_PASSWORD=replace-with-a-strong-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-bytes
ADMIN_SESSION_SECONDS=28800

# Database. On Render/Railway/Fly, point this at a persistent disk/volume.
RAFFLE_DB_PATH=/data/raffle.db
RAFFLE_SEED_ON_INIT=1

# Public site URL used in receipts/emails/webhooks.
RAFFLE_BASE_URL=https://sweepstakes.example.com

# Email backend: preview writes .eml files only; smtp sends real email.
RAFFLE_MAIL_BACKEND=preview
RAFFLE_MAIL_FROM=jb@titancybersecurity.com
RAFFLE_MAIL_FROM_NAME=Titan Cybersecurity
RAFFLE_MAIL_REPLY_TO=jb@titancybersecurity.com

# SMTP backend, if RAFFLE_MAIL_BACKEND=smtp
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=true

# Stripe - setting STRIPE_SECRET_KEY enables real Stripe methods.
# Mock payments are OFF by default and must stay off in production.
ALLOW_MOCK_PAYMENTS=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# PayPal/Venmo
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
PAYPAL_MODE=live

# Manual payment display settings
ZELLE_HANDLE=
ZELLE_NAME=

# Privacy/security salt for hashed requester IPs. Use a stable random value.
SWEEPS_IP_SALT=replace-with-random-secret

# Mail-in AMOE fallback defaults. Per-sweepstakes DB values override these.
SWEEPS_MAIL_NAME=Mother's Day Sweepstakes Drawing
SWEEPS_MAIL_ATTN=Free Entry
SWEEPS_MAIL_STREET=5456 Peachtree Blvd, Suite 134
SWEEPS_MAIL_CITY=Atlanta
SWEEPS_MAIL_STATE=GA
SWEEPS_MAIL_ZIP=30341
